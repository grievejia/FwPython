import FwPython.Static.Subtyping.ClassContext
import FwPython.Static.Subtyping.WellFormedTy

set_option autoImplicit false

/-! # Equations for valid static types

The lattice, function, and class equations generate type equality. Subtyping
follows from the union equation: adding a source type as an alternative must
leave the target unchanged.

The types carry name-validity proofs, and the context supplies the hierarchy
facts that the equations use. These facts include MRO order compatibility,
so classes with conflicting orders have an empty intersection.
-/

namespace FwPython.Static.Subtyping

/-- Object as a valid type in this class context. -/
def ValidatedClassContext.objectType (context : ValidatedClassContext) : WellFormedType context.names :=
  .class_ objectClass context.valid.objectKnown

/-- BoundMethod as a valid type in this class context. -/
def ValidatedClassContext.boundMethodType (context : ValidatedClassContext) : WellFormedType context.names :=
  .class_ boundMethodClass context.valid.boundMethodKnown

/-- Equality of valid types generated by the lattice, function, and class laws. -/
inductive TypeEquivalence (context : ValidatedClassContext) :
    WellFormedType context.names → WellFormedType context.names → Prop where
  /-- Every valid type equals itself. -/
  | refl {T : WellFormedType context.names} : TypeEquivalence context T T
  /-- An equation can be used in either direction. -/
  | symm {T U : WellFormedType context.names} (equation : TypeEquivalence context T U) :
      TypeEquivalence context U T
  /-- Two equations with a common middle type compose. -/
  | trans {T U V : WellFormedType context.names} (first : TypeEquivalence context T U)
      (second : TypeEquivalence context U V) : TypeEquivalence context T V
  /-- Equal alternatives give equal unions. -/
  | union {T U V W : WellFormedType context.names} (left : TypeEquivalence context T U)
      (right : TypeEquivalence context V W) :
      TypeEquivalence context (.union T V) (.union U W)
  /-- Equal requirements give equal intersections. -/
  | intersection {T U V W : WellFormedType context.names} (left : TypeEquivalence context T U)
      (right : TypeEquivalence context V W) :
      TypeEquivalence context (.intersection T V) (.intersection U W)
  /-- Equal input and result types give equal function requirements. -/
  | callable {P Q R S : WellFormedType context.names} (input : TypeEquivalence context P Q)
      (result : TypeEquivalence context R S) :
      TypeEquivalence context (.callable P R) (.callable Q S)
  /-- The order of a union's alternatives does not affect the type. -/
  | unionCommutative {T U : WellFormedType context.names} :
      TypeEquivalence context (.union T U) (.union U T)
  /-- The order of an intersection's requirements does not affect the type. -/
  | intersectionCommutative {T U : WellFormedType context.names} :
      TypeEquivalence context (.intersection T U) (.intersection U T)
  /-- Grouping three union alternatives does not affect the type. -/
  | unionAssociative {T U V : WellFormedType context.names} :
      TypeEquivalence context (.union (.union T U) V) (.union T (.union U V))
  /-- Grouping three intersection requirements does not affect the type. -/
  | intersectionAssociative {T U V : WellFormedType context.names} :
      TypeEquivalence context (.intersection (.intersection T U) V) (.intersection T (.intersection U V))
  /-- A union absorbs an alternative that also satisfies its first type. -/
  | unionAbsorption {T U : WellFormedType context.names} :
      TypeEquivalence context (.union T (.intersection T U)) T
  /-- An intersection absorbs a requirement that includes its first type. -/
  | intersectionAbsorption {T U : WellFormedType context.names} :
      TypeEquivalence context (.intersection T (.union T U)) T
  /-- An empty union alternative adds no values. -/
  | unionBottom {T : WellFormedType context.names} : TypeEquivalence context (.union T .bottom) T
  /-- Requiring Object adds no restriction. -/
  | intersectionObject {T : WellFormedType context.names} :
      TypeEquivalence context (.intersection T context.objectType) T
  /-- Intersecting with a union is the union of the two intersections. -/
  | intersectionDistributes {T U V : WellFormedType context.names} :
      TypeEquivalence context (.intersection T (.union U V)) (.union (.intersection T U) (.intersection T V))
  /-- A common result requirement on two inputs is the requirement on their union. -/
  | functionUnionInput {P Q R : WellFormedType context.names} :
      TypeEquivalence context (.callable (.union P Q) R) (.intersection (.callable P R) (.callable Q R))
  /-- Two result requirements on one input are the requirement on their intersection. -/
  | functionIntersectionResult {P R S : WellFormedType context.names} :
      TypeEquivalence context (.callable P (.intersection R S)) (.intersection (.callable P R) (.callable P S))
  /-- An empty input imposes no call requirement beyond being a BoundMethod. -/
  | functionEmptyInput {R : WellFormedType context.names} :
      TypeEquivalence context (.callable .bottom R) context.boundMethodType
  /-- A class and its exclusion cover Object. -/
  | classComplement {C : Identifier} (known : C ∈ context.names) :
      TypeEquivalence context (.union (.class_ C known) (.negClass C known)) context.objectType
  /-- No value belongs to a class and its exclusion. -/
  | classContradiction {C : Identifier} (known : C ∈ context.names) :
      TypeEquivalence context (.intersection (.class_ C known) (.negClass C known)) .bottom
  /-- Membership in a known class includes membership in each listed ancestor. -/
  | inheritance {C A : Identifier} (known : C ∈ context.names)
      (ancestor : A ∈ context.ancestors C) :
      TypeEquivalence context
        (.intersection (.class_ C known) (.class_ A (context.valid.ancestorsKnown _ known _ ancestor)))
        (.class_ C known)
  /-- A sealed class excludes a known class outside its ancestor list. -/
  | sealedExclusion {B C : Identifier} (sealed : B ∈ sealedClasses)
      (known : C ∈ context.names) (outside : C ∉ context.ancestors B) :
      TypeEquivalence context
        (.intersection (.class_ B (context.valid.sealedKnown _ sealed)) (.class_ C known)) .bottom
  /-- Classes whose MROs have no common order cannot share a value. -/
  | incompatibleClasses {classes : List Identifier}
      (known : ∀ name ∈ classes, name ∈ context.names)
      (failed : hasValidClassOrder context classes = false) :
      TypeEquivalence context
        (.meetTypes context.valid.objectKnown
          (classes.attach.map fun name => .class_ name.val (known _ name.property))) .bottom

namespace TypeEquivalence

variable {context : ValidatedClassContext}

/-- Subtyping is the union equation between validated types.
The raw indices let syntax-based typing judgments refer to these types. -/
inductive Subtype (context : ValidatedClassContext) : Ty → Ty → Prop where
  /-- Adding the validated source as a union alternative leaves the target unchanged. -/
  | intro {source target : WellFormedType context.names}
      (equation : TypeEquivalence context (.union source target) target) :
      Subtype context source.raw target.raw

/-- The source of a subtype proof uses known class names. -/
theorem Subtype.sourceNamesKnown {T U : Ty} (included : Subtype context T U) : TypeNamesKnown context.names T := by
  cases included with
  | @intro source _ _ => exact source.namesKnown

/-- The target of a subtype proof uses known class names. -/
theorem Subtype.targetNamesKnown {T U : Ty} (included : Subtype context T U) : TypeNamesKnown context.names U := by
  cases included with
  | @intro _ target _ => exact target.namesKnown

/-- The validated source annotation of a subtype proof. -/
def Subtype.sourceType {T U : Ty} (included : Subtype context T U) : WellFormedType context.names :=
  ⟨T, included.sourceNamesKnown⟩

/-- The validated target annotation of a subtype proof. -/
def Subtype.targetType {T U : Ty} (included : Subtype context T U) : WellFormedType context.names :=
  ⟨U, included.targetNamesKnown⟩

/-- The equation that defines this subtype proof. -/
theorem Subtype.equation {T U : Ty} (included : Subtype context T U) :
    TypeEquivalence context (.union included.sourceType included.targetType) included.targetType := by
  cases included with
  | intro equation => exact equation

section Equations
variable {T U V P Q R S : WellFormedType context.names}

/-- Repeated intersection requirements follow from absorption. -/
theorem intersectionIdempotent : TypeEquivalence context (.intersection T T) T :=
  .trans (.intersection .refl (unionAbsorption (T := T) (U := T)).symm) .intersectionAbsorption

/-- Repeated union alternatives follow from absorption. -/
theorem unionIdempotent : TypeEquivalence context (.union T T) T :=
  .trans (.union .refl (intersectionAbsorption (T := T) (U := T)).symm) .unionAbsorption

/-- The union and intersection equations define the same order on valid types. -/
theorem subtype_iff_intersection (source target : WellFormedType context.names) :
    Subtype context source.raw target.raw ↔ TypeEquivalence context (.intersection source target) source := by
  constructor
  · intro joined
    exact .trans (.intersection .refl joined.equation.symm) .intersectionAbsorption
  · intro included
    exact .intro (.trans (.union included.symm .refl)
      (.trans .unionCommutative (.trans (.union .refl .intersectionCommutative) .unionAbsorption)))

/-- An equation gives subtyping between its valid types. -/
theorem toSubtype (equation : TypeEquivalence context T U) : Subtype context T.raw U.raw :=
  .intro (.trans (.union equation .refl) unionIdempotent)

/-- An intersection with bottom is empty. -/
theorem meetBottom : TypeEquivalence context (.intersection T .bottom) .bottom :=
  .trans .intersectionCommutative
    (.trans (TypeEquivalence.trans .unionCommutative .unionBottom).symm .unionAbsorption)

/-- Object absorbs every union alternative. -/
theorem unionObject :
    TypeEquivalence context (.union T context.objectType) context.objectType :=
  .trans (.union (intersectionObject).symm .refl)
    (.trans .unionCommutative (.trans (.union .refl .intersectionCommutative) .unionAbsorption))

/-- Object's exclusion is empty. -/
theorem negativeObject :
    TypeEquivalence context (.negClass objectClass context.valid.objectKnown) .bottom :=
  .trans (intersectionObject).symm (.trans .intersectionCommutative (.classContradiction context.valid.objectKnown))
end Equations

section Subtypes
variable {T U V P Q R S : Ty}

/-- Subtype proofs compose within one class context. -/
theorem Subtype.trans (first : Subtype context T U) (second : Subtype context U V) : Subtype context T V :=
  .intro (.trans (.union .refl second.equation.symm)
    (.trans unionAssociative.symm (.trans (.union first.equation .refl) second.equation)))

/-- Every valid type is below itself. -/
theorem Subtype.refl (known : TypeNamesKnown context.names T) : Subtype context T T :=
  .intro (unionIdempotent (T := ⟨T, known⟩))

/-- Mutual subtyping gives an equation between the two valid types. -/
theorem ofSubtypes {source target : WellFormedType context.names}
    (forward : Subtype context source.raw target.raw) (backward : Subtype context target.raw source.raw) :
    TypeEquivalence context source target :=
  .trans backward.equation.symm (.trans .unionCommutative forward.equation)

/-- Bottom is below every valid type. -/
theorem Subtype.bottom (known : TypeNamesKnown context.names T) : Subtype context .bottom T :=
  .intro (.trans .unionCommutative (unionBottom (T := ⟨T, known⟩)))

/-- Object is above every valid type. -/
theorem Subtype.objectTop (known : TypeNamesKnown context.names T) :
    Subtype context T (.class_ objectClass) := .intro (unionObject (T := ⟨T, known⟩))

/-- If the second component is below the target, its intersection with a valid type is also below it. -/
theorem Subtype.interRight (included : Subtype context U V) (leftKnown : TypeNamesKnown context.names T) :
    Subtype context (.intersection T U) V := by
  apply Subtype.trans (U := U) ?_ included
  exact .intro (.trans .unionCommutative
    (.trans (.union .refl (intersectionCommutative (T := ⟨T, leftKnown⟩) (U := included.sourceType))) .unionAbsorption))

/-- If the first component is below the target, its intersection with a valid type is also below it. -/
theorem Subtype.interLeft (included : Subtype context T V) (rightKnown : TypeNamesKnown context.names U) :
    Subtype context (.intersection T U) V :=
  Subtype.trans (toSubtype (intersectionCommutative (T := included.sourceType) (U := ⟨U, rightKnown⟩)))
    (.interRight included rightKnown)

/-- Two upper bounds give their intersection as an upper bound. -/
theorem Subtype.interIntro (left : Subtype context T U) (right : Subtype context T V) :
    Subtype context T (.intersection U V) :=
  (subtype_iff_intersection left.sourceType (.intersection left.targetType right.targetType)).mpr
    (.trans intersectionAssociative.symm
      (.trans (.intersection ((subtype_iff_intersection left.sourceType left.targetType).mp left) .refl)
        ((subtype_iff_intersection right.sourceType right.targetType).mp right)))

/-- A type below the first alternative is below the union. -/
theorem Subtype.unionLeft (included : Subtype context T U) (rightKnown : TypeNamesKnown context.names V) :
    Subtype context T (.union U V) :=
  Subtype.trans included (.intro (.trans unionAssociative.symm
    (.union (unionIdempotent (T := included.targetType)) (TypeEquivalence.refl (T := ⟨V, rightKnown⟩)))))

/-- A type below the second alternative is below the union. -/
theorem Subtype.unionRight (included : Subtype context T V) (leftKnown : TypeNamesKnown context.names U) :
    Subtype context T (.union U V) :=
  Subtype.trans (.unionLeft (V := U) included leftKnown)
    (toSubtype (unionCommutative (T := included.targetType) (U := ⟨U, leftKnown⟩)))

/-- Both union alternatives must satisfy the target. -/
theorem Subtype.unionElim (left : Subtype context T V) (right : Subtype context U V) :
    Subtype context (.union T U) V :=
  .intro (.trans unionAssociative (.trans (.union .refl right.equation) left.equation))

/-- Function subtyping reverses inputs and preserves results. -/
theorem Subtype.callable (domain : Subtype context Q P) (result : Subtype context R S) :
    Subtype context (.callable P R) (.callable Q S) := by
  have joined : TypeEquivalence context (.union domain.targetType domain.sourceType) domain.targetType :=
    .trans .unionCommutative domain.equation
  exact Subtype.trans
    ((subtype_iff_intersection (.callable domain.targetType result.sourceType)
      (.callable domain.sourceType result.sourceType)).mpr
      (.trans functionUnionInput.symm (.callable joined .refl)))
    ((subtype_iff_intersection (.callable domain.sourceType result.sourceType)
      (.callable domain.sourceType result.targetType)).mpr
      (.trans functionIntersectionResult.symm
        (.callable .refl ((subtype_iff_intersection result.sourceType result.targetType).mp result))))

/-- Every valid function type is below BoundMethod. -/
theorem Subtype.callableBoundMethod (inputKnown : TypeNamesKnown context.names P)
    (resultKnown : TypeNamesKnown context.names R) :
    Subtype context (.callable P R) (.class_ boundMethodClass) :=
  .trans (.callable (.bottom inputKnown) (.refl resultKnown))
    (toSubtype (functionEmptyInput (R := ⟨R, resultKnown⟩)))

/-- A known class is below each class in its MRO. -/
theorem Subtype.inheritance {className ancestorName : Identifier}
    (known : className ∈ context.names) (ancestor : ancestorName ∈ context.ancestors className) :
    Subtype context (.class_ className) (.class_ ancestorName) :=
  (subtype_iff_intersection (.class_ className known)
    (.class_ ancestorName (context.valid.ancestorsKnown _ known _ ancestor))).mpr
    (TypeEquivalence.inheritance known ancestor)

/-- A sealed class excludes known classes outside its ancestors. -/
theorem Subtype.sealedClassNegClass {B C : Identifier} (sealed : B ∈ sealedClasses)
    (known : C ∈ context.names) (outside : C ∉ context.ancestors B) :
    Subtype context (.class_ B) (.negClass C) := by
  apply (subtype_iff_intersection (.class_ B (context.valid.sealedKnown _ sealed)) (.negClass C known)).mpr
  exact .trans (TypeEquivalence.trans .unionCommutative .unionBottom).symm
    (.trans (.union (sealedExclusion sealed known outside).symm .refl)
      (.trans intersectionDistributes.symm
        (.trans (.intersection .refl (classComplement known)) (intersectionObject))))
end Subtypes
end TypeEquivalence
end FwPython.Static.Subtyping
